WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
VERIFY_TOKEN=my_verify_token_123
# ADMIN_TOKEN=optional password admin page ku (set pannina /admin la required)

# Delivery & payment
DELIVERY_FEE=30
# PAYMENT_UPI_ID=yourstore@upi  (native UPI deep link — "Continue to Pay" opens the
# phone's UPI app chooser: Google Pay / PhonePe / Paytm / any installed UPI app.
# Payment is confirmed ONLY server-side via PAYMENT_WEBHOOK_SECRET callback.)
# PAYMENT_LINK=https://your-paylink.provider/pay  (fallback when no UPI id set;
# also adds Card/Netbanking/Wallet options on the /pay page)

# Payment provider → server callback secret. Payments become "Paid" ONLY via
# this webhook (or the simulator); never by a button click. Two auth forms:
#   body: { secret: ... }           (legacy, shared secret in the payload)
#   header: x-zipra-signature             (recommended) = HMAC-SHA256 hex of the raw
#     JSON body using this same PAYMENT_WEBHOOK_SECRET as the key.
# Sample callback POST to /api/payment/webhook:
#   { "order_no":"ZIP…", "status":"success", "txn_id":"PGTX…", "amount":105 }
# Amount is cross-checked against the order total — mismatches are never marked Paid.
PAYMENT_WEBHOOK_SECRET=

# Native WhatsApp Payments (pay INSIDE the chat, Meta-hosted).
# Server already understands Meta's webhook forms:
#   - statuses[].type == "payment"  with payment.reference_id = your order no,
#     payment.amount, and status captured/failed/pending/refunded (PG Deep Integration)
#   - message-level interactive payment callback (legacy WhatsApp Pay)
# ALREADY handles these; no code change needed once Meta approves you. Requirements:
#   1. Meta business verification (currently pending_submission on the live account)
#   2. WhatsApp Payments onboarding with a payment gateway
#      (Razorpay / PayU / BillDesk / Zaakpay — India) via Business Manager;
#      often needs a note to whatsappindia-bizpayments-support@meta.com
#   Until then, "Pay Now" opens the WhatsApp in-app browser → the /pay page with a
#   genuine UPI deep link — the closest supported in-WhatsApp experience (no fake UI).
# WHATSAPP_PAYMENT=1
# PAYMENT_RECEIVER=91xxxxxxxxxx

# Web app base URL (must be reachable from the customer's phone)
WEB_APP_URL=https://your-tunnel.example

# Demo-only: enables /api/payment/simulate/:orderNo marker
# PAYMENT_SIMULATOR=1

# Session inactivity timeout (ms) before the bot sends the timeout message
SESSION_TIMEOUT_MS=300000

# Database (SQLite via node:sqlite). Leave default to store at ./data/zipra.db
# DB_PATH=./data/zipra.db

PORT=3000
ADMIN_TOKEN=
